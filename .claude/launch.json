{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "serve-coach",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "serve-coach-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "autoPort": true,
      "port": 5173
    },
    {
      "name": "serve-coach-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190
    },
    {
      "name": "serve-coach-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview:lan"
      ],
      "port": 5280,
      "url": "https://localhost:5280"
    },
    {
      "name": "serve-coach-isolated",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set ISOLATE=1&& npx vite --port 5184 --strictPort"
      ],
      "port": 5184
    },
    {
      "name": "serve-coach-pay",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_PAYMENTS=mock&& npx vite --port 5186 --strictPort"
      ],
      "port": 5186
    },
    {
      "name": "serve-coach-pay-offers",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_PAYMENTS=mock&& set VITE_PRICE_LINE=a test price a month&& set VITE_PRICE_LINE_ANNUAL=a test price a year&& set VITE_TRIAL_DAYS=7&& npx vite --port 5187 --strictPort"
      ],
      "port": 5187
    }
  ]
}
