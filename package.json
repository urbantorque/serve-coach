{
  "name": "serve-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline tennis serve analysis. Your video never leaves your device.",
  "scripts": {
    "predev": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "replay:fixture": "node scripts/replay-fixture.mjs",
    "setup:assets": "node scripts/fetch-assets.mjs",
    "setup:bench": "node scripts/fetch-bench.mjs",
    "bench:mocap": "node scripts/bench-mocap.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "onnxruntime-web": "^1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
