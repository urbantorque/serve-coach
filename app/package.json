{
  "name": "serve-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "copy:mediapipe": "node scripts/copy-mediapipe.mjs",
    "postinstall": "npm run copy:mediapipe"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@mediapipe/tasks-vision": "1.0.1",
    "@phosphor-icons/react": "2.1.10",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "motion": "13.4.4",
    "mp4box": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "fake-indexeddb": "6.2.5",
    "ffmpeg-static": "5.3.0",
    "jsdom": "30.1.1",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  }
}
