node_modules
dist
dist-ssr
.scratch
*.local
.DS_Store
.vite

# Throwaway bundles from probing the engine outside the test runner. One of
# these — a 255 KB esbuild of the analysis pass — was left in src/lib/framing/,
# where `git add src/lib/framing` would have committed it with the workstream.
*.tmp.mjs
*.tmp.js

# Vendored by `npm run setup:assets` — regenerate rather than commit.
# The pose model alone is 9 MB and the WASM runtime another 19 MB.
public/models/
public/wasm/

# A pointer for a self-resuming agent loop to find its place across sessions —
# NEXT.md is still the one source of truth for what is done, this just avoids
# re-deriving "where was I" from git log every time. Not part of the programme.
.agent_state/

# Footage handed to the corpus ingest. Clips never enter the repo — see
# CORPUS.md: what is committable is the landmark dump, not the video.
clips/
*.corpus.json
