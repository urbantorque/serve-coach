+export function bentElbow(serve: MocapServe, degrees: number): MocapServe {
+  const top = mocapTruth(serve).wristTop
+  const n = MOCAP_POINTS.length
+  const xyz = new Float32Array(serve.xyz)
+  const past = [`${serve.hand}Wrist`, `${serve.hand}Index`, `${serve.hand}Pinky`, 'racket'] as MocapPoint[]
+  for (let f = 0; f < serve.count; f++) {
+    const t = f / serve.rate
+    const weight = easing((t - (top - 0.45)) / 0.25) * (1 - easing((t - (top + 0.15)) / 0.25))
+    if (weight <= 0) continue
+    const elbow = pointAt(serve, `${serve.hand}Elbow`, f)
+    const axis = cross(sub(pointAt(serve, `${serve.hand}Shoulder`, f), elbow), sub(pointAt(serve, `${serve.hand}Wrist`, f), elbow))
