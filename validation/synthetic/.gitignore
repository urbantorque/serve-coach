# Generated by tools/synth (deterministic; regenerate with `npx tsx tools/synth/src/cli.ts --all`).
# Videos are ignored by the root .gitignore. Per-frame truth for the full corpus is ~100 MB, so only
# the small CI set's truth is kept in git (it also feeds InjectedPoseSource tests without video).
clips/*/truth.json
!clips/quick-*/truth.json
